# TEMPLATE — copy to .env and fill in real values:
#     cp infra/.env.example infra/.env
# Generate strong secrets, e.g.:  openssl rand -base64 48
# These credentials are the source of truth; every app that reuses infra must
# reference the SAME values in its own .env (composite URLs, PROVISION_* keys).

# ── PostgreSQL / pgvector (cluster-wide superuser) ──
POSTGRES_USER=CHANGE_ME_admin_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=embedding_db

# ── MySQL (root + default app user) ──
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MYSQL_USER=CHANGE_ME_app_user
MYSQL_PASSWORD=CHANGE_ME_strong_password
MYSQL_DATABASE=app_db

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME_strong_password

# ── RabbitMQ (admin) ──
RABBITMQ_DEFAULT_USER=CHANGE_ME_admin_user
RABBITMQ_DEFAULT_PASS=CHANGE_ME_strong_password

# ── MinIO (root) ──
MINIO_ROOT_USER=CHANGE_ME_access_key
MINIO_ROOT_PASSWORD=CHANGE_ME_secret_key

# ── Meilisearch ──
MEILI_MASTER_KEY=CHANGE_ME_generate_with_openssl_rand_base64_48
