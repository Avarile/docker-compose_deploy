# ─────────────────────────────────────────────────────────────────────────────
# Global, shared, NON-secret knobs. Copy to .env and adjust for this host:
#     cp .env.example .env
# These are the only values shared across every stack. Credentials live in each
# stack's own .env (infra/.env, apps/<name>/.env).
# ─────────────────────────────────────────────────────────────────────────────

# Compose project name (container/volume/network prefix).
COMPOSE_PROJECT_NAME=platform

# Where all persistent bind-mount data lives on THIS host. Mirrors the k3s
# ~/k3s-data/<service> layout so the same backup/rsync workflow applies. Use an
# ABSOLUTE path — it is interpolated into every stack's volume definitions.
DATA_ROOT=/home/avarile/dev-ops/docker-deployment/data

# The address browsers/clients reach this host at. Used by apps that must hand
# out externally-resolvable URLs (MinIO presigned links, cybernetics origin,
# drawio/gitea/ghost public URLs). Set to this box's LAN IP or public domain.
# (Source cluster used the LAN IP 192.168.0.103.)
PUBLIC_IP=192.168.0.103

# Timezone applied to every container.
TZ=UTC
