# TEMPLATE — copy to .env and fill in real values:
#     cp apps/twenty/.env.example apps/twenty/.env
# Hostnames use the compose service names (pgvector / redis / minio).
# Credentials in the composite URLs MUST match the infra services they point at.
# Generate APP_SECRET, e.g.:  openssl rand -base64 32
APP_SECRET=CHANGE_ME_app_secret
PG_DATABASE_URL=postgres://CHANGE_ME_equals_infra_POSTGRES_USER:CHANGE_ME_equals_infra_POSTGRES_PASSWORD@pgvector:5432/twenty
REDIS_URL=redis://:CHANGE_ME_equals_infra_REDIS_PASSWORD@redis:6379/3
STORAGE_S3_ACCESS_KEY_ID=CHANGE_ME_equals_infra_MINIO_ROOT_USER
STORAGE_S3_SECRET_ACCESS_KEY=CHANGE_ME_equals_infra_MINIO_ROOT_PASSWORD

# ── provisioning (= infra pgvector superuser) ──
PROVISION_PG_USER=CHANGE_ME_equals_infra_POSTGRES_USER
PROVISION_PG_PASSWORD=CHANGE_ME_equals_infra_POSTGRES_PASSWORD
