# Plane NON-SECRET config — the docker-compose equivalent of the k3s plane-config
# ConfigMap, applied to every Plane service (like envFrom configMapRef). Tracked
# in git (no secrets here). Hostnames use compose service names / infra aliases
# (plane-db, plane-redis, plane-mq, plane-minio, api, live, monitor, iframely).

# ── core / platform ──
APP_VERSION=v2.6.3
APP_DOMAIN=https://projects.avarile.com
DEPLOY_PLATFORM=docker_compose
PRIME_HOST=https://prime.plane.so
IS_AIRGAPPED=0
IS_SELF_MANAGED=1
DEBUG=0

# ── public URLs / routing ──
WEB_URL=https://projects.avarile.com
CORS_ALLOWED_ORIGINS=https://projects.avarile.com
API_BASE_URL=http://api:8000
API_HOSTNAME=http://api:8000
LIVE_BASE_URL=http://live:3000
LIVE_BASE_PATH=/live
PI_BASE_PATH=/pi
# PI/AI services are intentionally NOT deployed (like k3s); /pi/ returns 502.
# Node-IP value — change with PUBLIC_IP if this host's address differs.
PI_BASE_URL=http://192.168.0.103:30808/pi
SILO_BASE_PATH=/silo

# ── gunicorn / limits ──
GUNICORN_WORKERS=2
FILE_SIZE_LIMIT=5242880
SSL_VERIFY=1
API_KEY_RATE_LIMIT=60/minute
ENABLE_DRF_SPECTACULAR=0
INTAKE_EMAIL_DOMAIN=example.com

# ── feature flag / payment server (monitor) ──
FEATURE_FLAG_SERVER_BASE_URL=http://monitor:8080
PAYMENT_SERVER_BASE_URL=http://monitor:8080

# ── monitor self-checks ──
SERVICE_HTTP_WEB=web:3000
SERVICE_HTTP_API=api:8000
SERVICE_HTTP_LIVE=live:3000/live/health
SERVICE_HTTP_PROXY=proxy:80
SERVICE_HTTP_MINIO=plane-minio:9000
SERVICE_TCP_REDIS=plane-redis:6379
SERVICE_TCP_POSTGRES=plane-db:5432
TRUSTED_PROXIES=0.0.0.0/0

# ── proxy (Caddy) — HTTP only, ACME disabled ──
SITE_ADDRESS=:80
APP_PROTOCOL=https
CERT_EMAIL=admin@example.com
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# ── backing-service non-secret coordinates (hosts via infra aliases) ──
REDIS_HOST=plane-redis
REDIS_PORT=6379
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=plane
RABBITMQ_DEFAULT_VHOST=plane

# ── object storage (non-secret) ──
USE_MINIO=1
USE_STORAGE_PROXY=1
MINIO_ENDPOINT_SSL=0
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=plane-uploads
BUCKET_NAME=plane-uploads

# ── search (disabled) ──
OPENSEARCH_ENABLED=0

# ── silo (integrations) non-secret ──
PORT=3000
BATCH_SIZE=60
DEDUP_INTERVAL=3
MQ_PREFETCH_COUNT=10
APP_BASE_URL=https://projects.avarile.com
SILO_API_BASE_URL=https://projects.avarile.com
SLACK_BASE_URL=https://slack.com

# ── live ──
IFRAMELY_URL=http://iframely:8061

# ── outbox poller tuning ──
OUTBOX_POLLER_MEMORY_LIMIT_MB=512
OUTBOX_POLLER_INTERVAL_MIN=0.25
OUTBOX_POLLER_INTERVAL_MAX=2
OUTBOX_POLLER_BATCH_SIZE=250
OUTBOX_POLLER_MEMORY_CHECK_INTERVAL=30
OUTBOX_POLLER_POOL_SIZE=4
OUTBOX_POLLER_POOL_MIN_SIZE=2
OUTBOX_POLLER_POOL_MAX_SIZE=10
OUTBOX_POLLER_POOL_TIMEOUT=30.0
OUTBOX_POLLER_POOL_MAX_IDLE=300.0
OUTBOX_POLLER_POOL_MAX_LIFETIME=3600
OUTBOX_POLLER_POOL_RECONNECT_TIMEOUT=5.0
OUTBOX_POLLER_POOL_HEALTH_CHECK_INTERVAL=60

# ── automation consumer ──
AUTOMATION_EVENT_STREAM_QUEUE_NAME=plane.event_stream.automations
AUTOMATION_EVENT_STREAM_PREFETCH=10
AUTOMATION_EXCHANGE_NAME=plane.event_stream
