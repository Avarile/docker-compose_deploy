# TEMPLATE — copy to .env and fill in real values:
#     cp apps/plane/.env.example apps/plane/.env
# Hostnames use Plane's stock names (plane-db / plane-redis / plane-mq), aliased
# to the shared infra services. Rules:
#   • POSTGRES_PASSWORD / DATABASE_URL / FOLLOWER_POSTGRES_URI share ONE plane DB password.
#   • RABBITMQ_DEFAULT_PASS must equal the password inside AMQP_URL.
#   • AWS_*/MINIO_ROOT_* must equal the infra MinIO root credentials.
#   • REDIS_URL uses the infra REDIS_PASSWORD (logical DB 1).
#   • PROVISION_PG_* / PROVISION_MQ_* are the infra ADMIN creds (used by plane-init).
# Generate secrets, e.g.:  openssl rand -hex 32   /   openssl rand -hex 16 (signature)
AES_SECRET_KEY=CHANGE_ME_32_char_aes_key
AMQP_URL=amqp://plane:CHANGE_ME_plane_mq_password@plane-mq:5672/plane
AWS_ACCESS_KEY_ID=CHANGE_ME_equals_infra_MINIO_ROOT_USER
AWS_SECRET_ACCESS_KEY=CHANGE_ME_equals_infra_MINIO_ROOT_PASSWORD
DATABASE_URL=postgresql://plane:CHANGE_ME_plane_db_password@plane-db/plane
FOLLOWER_POSTGRES_URI=postgresql://plane:CHANGE_ME_plane_db_password@plane-db/plane
LIVE_SERVER_SECRET_KEY=CHANGE_ME_live_key
MACHINE_SIGNATURE=CHANGE_ME_uuid
MINIO_ROOT_PASSWORD=CHANGE_ME_equals_infra_MINIO_ROOT_PASSWORD
MINIO_ROOT_USER=CHANGE_ME_equals_infra_MINIO_ROOT_USER
PI_INTERNAL_SECRET=CHANGE_ME_pi_internal_secret
POSTGRES_DB=plane
POSTGRES_PASSWORD=CHANGE_ME_plane_db_password
POSTGRES_USER=plane
PROVISION_MQ_PASSWORD=CHANGE_ME_equals_infra_RABBITMQ_DEFAULT_PASS
PROVISION_MQ_USER=CHANGE_ME_equals_infra_RABBITMQ_DEFAULT_USER
PROVISION_PG_PASSWORD=CHANGE_ME_equals_infra_POSTGRES_PASSWORD
PROVISION_PG_USER=CHANGE_ME_equals_infra_POSTGRES_USER
RABBITMQ_DEFAULT_PASS=CHANGE_ME_plane_mq_password
RABBITMQ_DEFAULT_USER=plane
REDIS_URL=redis://:CHANGE_ME_equals_infra_REDIS_PASSWORD@plane-redis:6379/1
SECRET_KEY=CHANGE_ME_django_secret_key
SILO_HMAC_SECRET_KEY=CHANGE_ME_hmac_key
WEBHOOK_SECRET=CHANGE_ME_webhook_secret
