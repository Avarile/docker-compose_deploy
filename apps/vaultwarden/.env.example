# TEMPLATE — copy to .env and fill in real values:
#     cp apps/vaultwarden/.env.example apps/vaultwarden/.env
# Generate the admin token, e.g.:  openssl rand -base64 32
ADMIN_TOKEN=CHANGE_ME_admin_token

# Keep this "false" by default. Flip to "true" only long enough to register
# the first account, then set it back to "false" and
# `docker compose up -d vaultwarden`.
SIGNUPS_ALLOWED=false
