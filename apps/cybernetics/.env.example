# TEMPLATE — copy to .env and fill in real values:
#     cp apps/cybernetics/.env.example apps/cybernetics/.env
# Hostnames use compose service names (pgvector / redis). Credentials in the
# composite URLs MUST match the infra services. POSTGRES_*/REDIS_PASSWORD equal
# the infra values (used both by the app and by cybernetics-init-db/minio).
POSTGRES_USER=CHANGE_ME_equals_infra_POSTGRES_USER
POSTGRES_PASSWORD=CHANGE_ME_equals_infra_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_equals_infra_REDIS_PASSWORD

PRISMA_DATABASE_URL=postgresql://CHANGE_ME_equals_infra_POSTGRES_USER:CHANGE_ME_equals_infra_POSTGRES_PASSWORD@pgvector:5432/cybernetics?schema=public&statement_cache_size=1
VECTOR_DATABASE_URL=postgresql://CHANGE_ME_equals_infra_POSTGRES_USER:CHANGE_ME_equals_infra_POSTGRES_PASSWORD@pgvector:5432/cybernetics_embedding

BACKEND_CACHE_REDIS_URI=redis://default:CHANGE_ME_equals_infra_REDIS_PASSWORD@redis:6379/0
BACKEND_PERFORMANCE_CACHE=redis://default:CHANGE_ME_equals_infra_REDIS_PASSWORD@redis:6379/0

BACKEND_STORAGE_MINIO_ACCESS_KEY=CHANGE_ME_equals_infra_MINIO_ROOT_USER
BACKEND_STORAGE_MINIO_SECRET_KEY=CHANGE_ME_equals_infra_MINIO_ROOT_PASSWORD

CYBERNETICS_APP_TOKEN=CHANGE_ME_app_token
SECRET_KEY=CHANGE_ME_secret_key

AI_GATEWAY_API_KEY=CHANGE_ME_ai_gateway_key
MASTRA_API_KEY=CHANGE_ME_mastra_key
ELEVENLABS_API_KEY=CHANGE_ME_elevenlabs_key
