# TEMPLATE — copy to .env and fill in real values:
#     cp apps/evershop/.env.example apps/evershop/.env
# Hostnames use the compose service names (pgvector / minio).
# Credentials in the composite values MUST match the infra services they point at.

# Dedicated `evershop` role/db password on shared pgvector.
DB_PASSWORD=CHANGE_ME_evershop_db_password

# S3 (shared minio) credentials — evershop talks to minio using the root user,
# same as every other app stack in this repo.
AWS_ACCESS_KEY_ID=CHANGE_ME_equals_infra_MINIO_ROOT_USER
AWS_SECRET_ACCESS_KEY=CHANGE_ME_equals_infra_MINIO_ROOT_PASSWORD

# ── provisioning (= infra pgvector superuser) ──
PROVISION_PG_USER=CHANGE_ME_equals_infra_POSTGRES_USER
PROVISION_PG_PASSWORD=CHANGE_ME_equals_infra_POSTGRES_PASSWORD
